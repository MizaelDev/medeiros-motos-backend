# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o GitHub!

# Segredo para assinar os tokens JWT — use uma string longa e aleatória
JWT_SECRET=coloque_aqui_uma_string_secreta_bem_longa_e_aleatoria

# Senha do painel admin (será salva como hash no banco)
ADMIN_PASSWORD=suasenhaforteaqui

# Porta do servidor (Railway define automaticamente)
PORT=3001

# Origem permitida pelo CORS (URL do seu frontend)
FRONTEND_URL=http://localhost:5173
